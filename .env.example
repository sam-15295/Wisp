PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017/chatgpt
JWT_SECRET=change-me-to-a-long-random-string
OPENROUTER_API_KEY=your-openrouter-key
DEFAULT_AI_MODEL=openrouter/free
TOKEN_LIMIT=20000
# comma separated list of models a user may pick (DEFAULT_AI_MODEL is always allowed)
ALLOWED_MODELS=openrouter/free
# how many tokens of history may be sent to the AI, and the cap on one reply
MAX_CONTEXT_TOKENS=3000
MAX_REPLY_TOKENS=1500
# summary memory: fold old messages once more than SUMMARY_TRIGGER are waiting, always keep the newest SUMMARY_KEEP_RECENT as they are
SUMMARY_TRIGGER=16
SUMMARY_KEEP_RECENT=6
