PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017/wisp
NODE_ENV=development

# long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key
DEFAULT_AI_MODEL=openrouter/free
# comma separated list of models a user may pick (DEFAULT_AI_MODEL is always allowed)
ALLOWED_MODELS=openrouter/free

# token budget per user and how long one budget window lasts (hours)
TOKEN_LIMIT=20000
TOKEN_WINDOW_HOURS=5
# how many tokens of history may be sent to the AI, and the cap on one reply
MAX_CONTEXT_TOKENS=3000
MAX_REPLY_TOKENS=1500

# summary memory: fold old messages once more than SUMMARY_TRIGGER are waiting, always keep the newest SUMMARY_KEEP_RECENT as they are
SUMMARY_TRIGGER=16
SUMMARY_KEEP_RECENT=6

# brute-force protection: failed login/signup attempts allowed per IP in the time window
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MINUTES=15

# optional: replaces the default system prompt
# SYSTEM_PROMPT=You are a helpful assistant.
